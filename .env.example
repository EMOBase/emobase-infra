# Example environment for the per-server EMOBase infrastructure.
# Run one emobase-infra on every server that hosts the portal and/or species.
# For a quick start, run ./init.sh instead of copying this file; it fills in
# the values below and generates all secrets.

# ── Deployment ──────────────────────────────────────────────────────────────
# Public base URL of Keycloak (browser-facing), without a trailing slash.
# Direct HTTP example:  http://SERVER_IP:8081/ibb/keycloak
# TLS example:          https://auth.example.org/ibb/keycloak
# In production put a TLS reverse proxy in front and point it at
# 127.0.0.1:${KEYCLOAK_HOST_PORT}.
KEYCLOAK_PUBLIC_URL=http://localhost:8081/ibb/keycloak

# Keycloak base URL used by containers on the shared infra network.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/ibb/keycloak

# Host port where Keycloak is published.
KEYCLOAK_HOST_PORT=8081

# Public origin of the portal, if this server runs one. It is used for the
# initial realm redirect URI. On a species-only server, set it to the first
# species URL or leave the local default; add the other origins later with
# scripts/allow-origin.sh.
PORTAL_PUBLIC_SERVER=http://localhost:9080

# Name of the Docker network shared with the local portal and species stacks.
# Keep the same value in the three .env files on this server.
EMOBASE_INFRA_NETWORK=emobase-infra

# ── Keycloak shared realm ───────────────────────────────────────────────────
# The portal always uses this realm. A species deployment can reuse it or
# create a dedicated realm during its init.sh.
KEYCLOAK_REALM=ibb
KEYCLOAK_CLIENT_ID=ibb-client

# ── Secrets ─────────────────────────────────────────────────────────────────
# Generated by init.sh. Keep this file private.
#
# MYSQL_ROOT_PASSWORD and KEYCLOAK_CLIENT_SECRET must be copied into every
# deploy stack's .env. The deploy stacks' init.sh reads them from this file.
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
KEYCLOAK_CLIENT_SECRET=change-me-keycloak-client-secret

# Keycloak admin console credentials.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password

# Initial realm user imported by Keycloak. The password is temporary and must
# be changed on first login.
COCO_USERNAME=coco
COCO_PASSWORD=change-me-coco-password

# ── Keycloak runtime ────────────────────────────────────────────────────────
KEYCLOAK_JAVA_OPTS="-Xms256m -Xmx768m"
